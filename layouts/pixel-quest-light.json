{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "pixel-quest",
            "props": {
              "role": "chrome"
            }
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "pixel-quest",
                "props": {
                  "role": "spaces"
                }
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "pixel-quest",
                "props": {
                  "role": "agents"
                }
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "pixel-quest",
            "props": {
              "footer": true,
              "role": "chrome"
            }
          },
          "size": {
            "px": 32
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "pixel-quest",
            "props": {
              "role": "tabs"
            }
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pixel-quest",
                      "props": {
                        "role": "pane"
                      }
                    },
                    "reveal": "always",
                    "height": 32,
                    "position": "top"
                  },
                  "background": "#00000000",
                  "border": {
                    "width": 2,
                    "color": "#1f2638"
                  },
                  "focus": {
                    "width": 2,
                    "color": "#d49a3a"
                  },
                  "radius": 0,
                  "gap": 8,
                  "lone": true
                }
              },
              "background": {
                "image": "mods/pixel-quest/art/tablet-slate.png",
                "fit": "cover"
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "pixel-quest",
                        "props": {
                          "role": "files"
                        }
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "pixel-quest",
                        "props": {
                          "role": "changes"
                        }
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true,
              "border": {
                "width": 2,
                "color": "#d49a3a"
              },
              "radius": 0,
              "background": "#e4e8f0"
            }
          ],
          "padding": 8,
          "gap": 8,
          "floating": [
            {
              "id": "party",
              "content": {
                "mod": "pixel-quest",
                "props": {
                  "role": "party"
                }
              },
              "edge": "right",
              "align": "center",
              "peek": 58
            }
          ]
        },
        {
          "id": "sill",
          "type": "block",
          "content": {
            "mod": "pixel-quest",
            "props": {
              "role": "sill"
            }
          },
          "size": {
            "px": 8
          }
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "pixel-quest",
            "props": {
              "role": "status"
            }
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": {
    "image": "mods/pixel-quest/art/bg-slate.png",
    "fit": "cover"
  },
  "terminal_padding": [
    12,
    10
  ],
  "terminal_opacity": 0.3,
  "divider": {
    "width": 2,
    "color": "#1f2638"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "theme": "pixel-quest-light",
  "font": "GalmuriMono11",
  "font_size": 12,
  "ui_font": "Galmuri11",
  "terminal_menu": "pixel-quest",
  "preview": "layouts/pixel-quest-light.png"
}
